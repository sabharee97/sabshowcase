{
  "settings": {
    "currentPage": "index.html",
    "theme": {
      "name": "tokenm5",
      "title": "TokenM5",
      "styling": {
        "primaryColor": "#cbff5b",
        "secondaryColor": "#232323",
        "successColor": "#30FFBB",
        "infoColor": "#ffffff",
        "warningColor": "#FFB130",
        "dangerColor": "#FF3F30",
        "mainFont": "Anonymous Pro",
        "display1Font": "Anonymous Pro",
        "display1Size": 7.5,
        "display2Font": "Anonymous Pro",
        "display2Size": 6,
        "display5Font": "Anonymous Pro",
        "display5Size": 4.2,
        "display7Font": "Anonymous Pro",
        "display7Size": 2,
        "display4Font": "Anonymous Pro",
        "display4Size": 1.52,
        "isRoundedImages": true,
        "isRoundedButtons": true,
        "isLargeButtons": false,
        "isGhostButtonBorder": false,
        "underlinedLinks": false,
        "isAnimatedOnScroll": false,
        "isScrollToTopButton": false
      },
      "titlePreset": "Cryptocurrency Platform",
      "nameSelectPreset": "cryptocurrency-platform",
      "presetSourceTheme": "tokenm5"
    },
    "path": "@PROJECT_PATH@",
    "name": "sabharees",
    "versionFirst": "5.9.18",
    "siteFonts": [
      {
        "css": "'Anonymous Pro', monospace",
        "name": "Anonymous Pro",
        "url": "https://fonts.googleapis.com/css?family=Anonymous+Pro:400,400i,700,700i"
      }
    ],
    "imageResize": true,
    "uniqCompNum": 0,
    "versionPublish": "6.0.6",
    "screenshot": "screenshot.png",
    "publishChangesOnly": false,
    "favicon": "@PROJECT_PATH@/assets/images/icons8-superman-50201-50x50.png",
    "mbrsiteDomain": "6u27hefdbk",
    "usedWebp": false,
    "robotsSwitcher": false,
    "sitemapSwitcher": false,
    "sitemapSwitcherAuto": false,
    "siteUrl": false,
    "cookiesAlert": false,
    "gdpr": false
  },
  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              ".title-wrapper": {
                "margin-bottom": "40px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "30px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "0"
                },
                ".mbr-section-subtitle": {
                  "margin-bottom": "0"
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "30%",
                  "margin-bottom": "40px",
                  "@media (max-width: 1200px)": {
                    "width": "60%"
                  },
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "30px"
                  }
                }
              },
              ".tag-wrapper": {
                "margin-top": "90px",
                "@media (max-width: 992px)": {
                  "margin-top": "30px"
                },
                ".tag-wrap": {
                  "display": "inline-flex",
                  "align-items": "center",
                  "background-color": "@tagBg",
                  "box-shadow": "0 1px 1px 1px @tagBorder",
                  "padding": "14px",
                  ".mbr-iconfont": {
                    "width": "32px",
                    "height": "32px",
                    "min-width": "32px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "border-radius": "100%",
                    "background-color": "@tagBorder",
                    "color": "@tagBg",
                    "font-size": "18px",
                    "margin-right": "12px"
                  },
                  ".mbr-tag": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#cbff5b"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-tag, .tag-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            },
            ".hideContainer": {
              "display": "none"
            }
          },
          "_name": "header01",
          "_sourceTheme": "tokenm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 tokenm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Tag\" name=\"showTag\" checked>\n        <input type=\"checkbox\" title=\"Tag Icon\" name=\"showIcon\" condition=\"showTag\" checked>\n        <input type=\"color\" title=\"Tag BG\" value=\"#232323\" name=\"tagBg\" condition=\"showTag\" selected>\n        <input type=\"color\" title=\"Tag Border\" value=\"#ffffff\" name=\"tagBorder\" condition=\"showTag\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showSubtitle\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                            <b>Sabharees.in</b></h2>\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-1\" mbr-if=\"showSubtitle\"></h2>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\"><b>** In Progress, LoL **</b></p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://www.linkedin.com/in/sabharee97/\" data-app-placeholder=\"Type Text\">Find Me<span class=\"mobi-mbri mobi-mbri-growing-chart mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    <div class=\"tag-wrapper hideContainer\" mbr-if=\"showTag\">\n                        <div class=\"tag-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-cash mobi-mbri\" mbr-if=\"showIcon\"></span>\n                            <p class=\"mbr-tag mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-tag, .tag-wrapper\">sampleText<br></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uD3lkocI3e",
          "_anchor": "header01-1",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
}